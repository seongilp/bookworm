# 외부 도서 검색 API 키 (모두 선택 사항)
# 하나도 없으면 OpenLibrary(키 불필요)로 폴백하지만, 한국 도서는 알라딘 키 권장.

# 알라딘 TTBKey — https://www.aladin.co.kr/ttb/wblog_manage.aspx (권장: 한국 도서 + 페이지수)
NUXT_ALADIN_TTB_KEY=

# 카카오 REST 키 — https://developers.kakao.com (선택)
NUXT_KAKAO_REST_KEY=

# 구글 북스 API 키 — https://console.cloud.google.com (선택, 키 없이도 공유쿼터로 시도)
NUXT_GOOGLE_BOOKS_KEY=
